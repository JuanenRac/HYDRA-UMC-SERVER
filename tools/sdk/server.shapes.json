      ],
      "properties": {
        "users": {
          "type": "array",
          "items": {
            "type": "object"
          }
        }
      }
    },
    "ConnectionClient": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema_version",
        "id",
        "kind",
        "first_seen_utc",
        "last_seen_utc",
        "active_sessions",
        "logins_ok",
        "logins_failed"
      ],
      "properties": {
        "schema_version": {
          "type": "string",
          "enum": [
            "1.0"
          ]
        },
        "id": {
          "type": "string",
          "pattern": "^[0-9a-f]{16}$"
        },
        "kind": {
          "type": "string",
          "enum": [
            "studio",
            "suite",
            "android",
            "ios",
            "dsi",
            "watch",
            "voice",
            "other"
          ]
        },
        "user": {
          "type": "string"
        },
        "app_version": {
          "type": "string",
          "pattern": "^[0-9A-Za-z._-]{1,24}$"
        },
        "origin": {
          "type": "string",
          "enum": [
            "local",
            "remote"
          ]
        },
        "two_factor": {
          "type": "boolean"
        },
        "first_seen_utc": {
          "type": "string",
          "format": "date-time"
        },
        "last_seen_utc": {
          "type": "string",
          "format": "date-time"
        },
        "last_failure_utc": {
          "type": "string",
          "format": "date-time"
        },
        "active_sessions": {
          "type": "integer"
        },
        "logins_ok": {
          "type": "integer"
        },
        "logins_failed": {
          "type": "integer"
        },
        "ip": {
          "type": "string",
          "description": "Administrators only, and only when connections.recordAddress is on."
        },
        "agent": {
          "type": "string",
          "description": "Administrators only, and only when connections.recordAddress is on."
        }
      }
    },
    "ConnectionEvent": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema_version",
        "id",
        "at_utc",
        "action",
        "client_kind",
        "client_id"
      ],
      "properties": {
        "schema_version": {
          "type": "string",
          "enum": [
            "1.0"
          ]
        },
        "id": {
          "type": "integer"
        },
        "at_utc": {
          "type": "string",
          "format": "date-time"
        },
        "action": {
          "type": "string",
          "enum": [
            "first_seen",
            "login",
            "login_failed",
            "second_factor_failed",
            "logout",
            "session_ended",
            "session_expired"
          ]
        },
        "client_kind": {
          "type": "string",
          "enum": [
            "studio",
            "suite",
            "android",
            "ios",
            "dsi",
            "watch",
            "voice",
            "other"
          ]
        },
        "client_id": {
          "type": "string",
          "pattern": "^[0-9a-f]{16}$"
        },
        "user": {
          "type": "string"
        },
        "origin": {
          "type": "string",
          "enum": [
            "local",
            "remote"
          ]
        },
        "two_factor": {
          "type": "boolean"
        },
        "app_version": {
          "type": "string",
          "pattern": "^[0-9A-Za-z._-]{1,24}$"
        },
        "ip": {
          "type": "string",
          "description": "Administrators only, and only when connections.recordAddress is on."
        },
        "agent": {
          "type": "string",
          "description": "Administrators only, and only when connections.recordAddress is on."
        }
      }
    },
    "GlobalStopReleased": {
      "type": "object",
      "required": [
        "success",
        "announced"
      ],
      "properties": {
        "success": {
          "type": "boolean"
        },
        "announced": {
          "type": "boolean",
          "description": "Whether the retained READY went out on the MQTT bridge (false when announcing is not configured or the broker is not connected)."
        }
      }
    },
    "InfoTicket": {
      "type": "object",
      "required": [
        "ticket",
        "expiresInSeconds"
      ],
      "properties": {
        "ticket": {
          "type": "string",
          "description": "Signed ticket for the read-only information routes; it goes in the address as ?ticket=."
        },
        "expiresInSeconds": {
          "type": "integer",
          "minimum": 30
        }
      }
    },
    "DeviceTokenView": {
      "type": "object",
      "required": [
        "id",
        "name",
        "username",
        "createdAt",
        "expiresAt",
        "revokedAt",
        "lastUsedAt",
        "state"
      ],
      "description": "A device token as the administrator sees it: who it is for and until when, never the token.",
      "properties": {
        "id": {
          "type": "string",
          "description": "The id of the token (22 URL-safe characters); the token itself is never kept."
        },
        "name": {
          "type": "string",
          "description": "What the administrator called the device."
        },
        "username": {
          "type": "string",
          "description": "The account the device signs in as."
        },
        "createdAt": {
          "type": "string"
        },
        "expiresAt": {
          "type": "string"
        },
        "revokedAt": {
          "type": [
            "string",
            "null"
          ]
        },
        "lastUsedAt": {
          "type": [
            "string",
            "null"
          ]
        },
        "state": {
          "type": "string",
          "enum": [
            "active",
            "expired",
            "revoked"
          ]
        }
      }
    },
    "DeviceTokenIssued": {
      "type": "object",
      "required": [
        "id",
        "name",
        "username",
        "createdAt",
        "expiresAt",
        "revokedAt",
        "lastUsedAt",
        "state",
        "token"
      ],
      "description": "A device token just issued. The token is in this answer and nowhere else: the server does not keep it.",
      "properties": {
        "id": {
          "type": "string",
          "description": "The id of the token (22 URL-safe characters); the token itself is never kept."
        },
        "name": {
          "type": "string",
          "description": "What the administrator called the device."
        },
        "username": {
          "type": "string",
          "description": "The account the device signs in as."
        },
        "createdAt": {
          "type": "string"
        },
        "expiresAt": {
          "type": "string"
        },
        "revokedAt": {
          "type": [
            "string",
            "null"
          ]
        },
        "lastUsedAt": {
          "type": [
            "string",
            "null"
          ]
        },
        "state": {
          "type": "string",
          "enum": [
            "active",
            "expired",
            "revoked"
          ]
        },
        "token": {
          "type": "string",
          "description": "Signed token of one device; the device presents it on POST /api/device/login."
        }
      }
    },
    "DeviceTokenList": {
      "type": "object",
      "required": [
        "items"
      ],
      "properties": {
        "items": {
          "type": "array",
          "items": {
            "$ref": "#/components/schemas/DeviceTokenView"
          }
        }
      }
    },
    "DeviceTokenRevoked": {
      "type": "object",
      "required": [
        "revoked",
        "sessionsEnded"
      ],
      "properties": {
        "revoked": {
          "type": "boolean"
        },
        "sessionsEnded": {
          "type": "integer",
          "minimum": 0
        }
      }
    },
    "UpdateItem": {
      "type": "object",
      "required": [
        "name",
        "family",
        "installed",
        "latest",
        "state"
      ],
      "properties": {
        "name": {
          "type": "string"
        },
        "family": {
          "type": [
            "string",
            "null"
          ]
        },
        "installed": {
          "type": [
            "string",
            "null"
          ]
        },
        "latest": {
          "type": [
            "string",
            "null"
          ],
          "description": "The newest published release, or null when it could not be looked up."
        },
        "state": {
          "type": "string",
          "enum": [
            "current",
            "behind",
            "ahead",
            "unknown"
          ]
        }
      }
    },
    "UpdateReport": {
      "type": "object",
      "required": [
        "checkedAt",
        "owner",
        "rateLimited",
        "items"
      ],
      "description": "The installed version of each program set against its newest published release. It reports; it never installs anything.",
      "properties": {
        "checkedAt": {
          "type": [
            "string",
            "null"
          ]
        },
        "owner": {
          "type": "string"
        },
        "rateLimited": {
          "type": "boolean",
          "description": "True when GitHub refused for quota during the look; the programs it did not reach have no newest version."
        },
        "items": {
          "type": "array",
          "items": {
            "$ref": "#/components/schemas/UpdateItem"
          }
        }
      }
    },
    "HealthReport": {
      "type": "object",
      "required": [
        "schema_version",
        "state",
        "timestamp_utc",
        "checks"
      ],
      "description": "The HealthReport contract of the SDK. Nothing else about the host is in it.",
      "properties": {
        "schema_version": {
          "type": "string"
        },
        "state": {
          "type": "string"
        },
        "timestamp_utc": {
          "type": "string"
        },
        "checks": {
          "type": "object"
        },
        "service": {
          "type": "string"
        }
      }
    },
    "RobotLiveness": {
      "type": "object",
      "required": [
        "schema_version",
        "stale_after_s",
        "robots"
      ],
      "properties": {
        "schema_version": {
          "type": "string"
        },
        "stale_after_s": {
          "type": "integer"
        },
        "robots": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "controller_id",
              "robot_id",
              "state"
            ],
            "description": "state is live (news within stale_after_s), stale (older news) or unknown (none since the server started). The flag online of the roster is not read.",
            "properties": {
              "controller_id": {
                "type": "string"
              },
              "robot_id": {
                "type": "integer"
              },
              "state": {
                "type": "string"
              },
              "last_update_utc": {
                "type": "string"
              },
              "age_s": {
                "type": "integer"
              },
              "source": {
                "type": "string",
                "description": "state (a command or a change of its state) or heartbeat."
              }
            }
          }
        }
      }
    },
    "RulConfig": {
      "type": "object",
      "required": [
        "enabled",
        "maxPoints",
        "timeoutMs"
      ],
      "description": "What a signed-in client may read of the remaining-useful-life relay: whether an operator may use it and the two limits that size a request. Nothing else; closed (enabled false, 5000 points, 8000 ms) when the configuration is missing or damaged.",
      "properties": {
        "enabled": {
          "type": "boolean",
          "description": "True only when the relay is open to operators (rul.enabled, or HYDRA_UMC_RUL=1)."
        },
        "maxPoints": {
          "type": "integer",
          "minimum": 8,
          "maximum": 100000,
          "description": "Largest number of points the relay accepts in one request."
        },
        "timeoutMs": {
          "type": "integer",
          "minimum": 500,
          "maximum": 60000,
          "description": "How long the relay waits for the detector, in milliseconds."
        }
      }
    },
    "EcosystemHealth": {
      "type": "object",
      "required": [
        "schema_version",
        "generated_at_utc",
        "available",
        "summary",
        "services",
        "certificate",
        "warnings"
      ],
      "description": "The health of the services of the ecosystem. Only on a server where ecosystemHealth.enabled is on (404 otherwise); for an operator or an administrator. The port, health path, unit and active state of a service are only in the answer to an administrator.",
      "properties": {
        "schema_version": {
          "type": "string"
        },
        "generated_at_utc": {
          "type": "string"
        },
        "available": {
          "type": "boolean",
          "description": "False when the sibling checkouts could not be scanned (no services then)."
        },
        "summary": {
          "type": "object",
          "required": [
            "total",
            "ok",
            "degraded",
            "down",
            "unknown",
            "drift"
          ],
          "properties": {
            "total": {
              "type": "integer"
            },
            "ok": {
              "type": "integer"
            },
            "degraded": {
              "type": "integer"
            },
            "down": {
              "type": "integer"
            },
            "unknown": {
              "type": "integer"
            },
            "drift": {
              "type": "integer"
            }
          }
        },
        "services": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "name",
              "family",
              "role",
              "state",
              "reason",
              "version_expected",
              "version_reported",
              "drift",
              "last_seen_utc",
              "latency_ms"
            ],
            "description": "state is ok, degraded, down or unknown; reason is a short code the clients translate. version_expected comes from the manifest, version_reported from the HealthReport of the service; drift is true only when both are known and differ.",
            "properties": {
              "name": {
                "type": "string"
              },
              "family": {
                "type": "string",
                "nullable": true
              },
              "role": {
                "type": "string",
                "nullable": true
              },
              "state": {
                "type": "string"
              },
              "reason": {
                "type": "string"
              },
              "version_expected": {
                "type": "string",
                "nullable": true
              },
              "version_reported": {
                "type": "string",
                "nullable": true
              },
              "drift": {
                "type": "boolean"
              },
              "last_seen_utc": {
                "type": "string",
                "nullable": true
              },
              "latency_ms": {
                "type": "integer",
                "nullable": true
              },
              "port": {
                "type": "integer",
                "nullable": true,
                "description": "Administrators only."
              },
              "health_path": {
                "type": "string",
                "nullable": true,
                "description": "Administrators only."
              },
              "systemd_unit": {
                "type": "string",
                "nullable": true,
                "description": "Administrators only."
              },
              "active_state": {
                "type": "string",
                "nullable": true,
                "description": "Administrators only."
              }
            }
          }
        },
        "certificate": {
          "type": "object",
          "nullable": true,
          "description": "The TLS certificate of this server; null when it runs without TLS. state is ok, expiring (fewer days left than warn_days), expired or unreadable.",
          "properties": {
            "state": {
              "type": "string"
            },
            "not_after_utc": {
              "type": "string",
              "nullable": true
            },
            "days_left": {
              "type": "integer",
              "nullable": true
            },
            "warn_days": {
              "type": "integer"
            }
          }
        },
        "warnings": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "code"
            ],
            "properties": {
              "code": {
                "type": "string"
              },
              "service": {
                "type": "string"
              }
            }
          }
        }
      }
    },
    "ConnectionClientList": {
      "type": "object",
      "required": [
        "clients"
      ],
      "properties": {
        "clients": {
          "type": "array",
          "items": {
            "$ref": "#/components/schemas/ConnectionClient"
          }
        }
      }
    },
    "ConnectionEventList": {
      "type": "object",
      "required": [
        "events"
      ],
      "properties": {
        "events": {
          "type": "array",
          "items": {
            "$ref": "#/components/schemas/ConnectionEvent"
          }
        }
      }
    },
    "PushDeviceRegistered": {
      "type": "object",
      "required": [
        "registered"
      ],
      "properties": {
        "registered": {
          "type": "boolean"
        }
      }
    },
    "PushDeviceRemoved": {
      "type": "object",
      "required": [
        "removed"
      ],
      "properties": {
        "removed": {
          "type": "boolean"
        }
      }
    },
    "PushStatus": {
      "type": "object",
      "required": [
        "enabled",
        "configured",
        "problem",
        "devices",
        "sandbox",
        "events"
      ],
      "description": "The state of the push notifications of the server, for an administrator. It tells whether the credentials of the Apple push service are usable and why not, never the credentials or the device tokens.",
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "configured": {
          "type": "boolean"
        },
        "problem": {
          "type": [
            "string",
            "null"
          ],
          "enum": [
            "missing",
            "key-in-repo",
            "key-unreadable",
            "invalid",
            null
          ]
        },
        "devices": {
          "type": "integer",
          "minimum": 0
        },
        "sandbox": {
          "type": "boolean"
        },
        "events": {
          "type": "object",
          "required": [
            "jobFinished",
            "globalStop"
          ],
          "properties": {
            "jobFinished": {
              "type": "boolean"
            },
            "globalStop": {
              "type": "boolean"
            }
          }
        }
      }
    },
    "BridgeState": {
      "type": "object",
      "required": [
        "name",
        "available",
        "state",
        "health",
        "updatedAt"
      ],
      "description": "What the gateway knows of one machine bridge from its retained topics: whether it is available (null when it never said), its last state and health report as the bridge published them, and when the last of them arrived.",
      "properties": {
        "name": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9_-]{0,31}$"
        },
        "available": {
          "type": [
            "boolean",
            "null"
          ],
          "description": "True while the bridge is online (or its health report is not a FAULT), false when offline, null when it published neither."
        },
        "state": {
          "description": "The last retained state of the bridge exactly as it published it (null when it published none)."
        },
        "health": {
          "description": "The last retained HealthReport of the bridge (null when it publishes none)."
        },
        "updatedAt": {
          "type": [
            "string",
            "null"
          ],
          "format": "date-time"
        }
      }
    },
    "BridgeList": {
      "type": "object",
      "required": [
        "connected",
        "bridges"
      ],
      "description": "The bridges the gateway has seen on the broker.",
      "properties": {
        "connected": {
          "type": "boolean",
          "description": "Whether the gateway is connected to the broker now."
        },
        "bridges": {
          "type": "array",
          "items": {
            "$ref": "#/components/schemas/BridgeState"
          }
        }
      }
    },
    "BridgeCommandAccepted": {
      "type": "object",
      "required": [
        "accepted",
        "result"
      ],
      "description": "The outcome of a command sent through the gateway: it was published, and the bridge answered (result holds its answer) or did not answer in time (result null).",
      "properties": {
        "accepted": {
          "type": "boolean"
        },
        "result": {
          "description": "The answer the bridge published on the result topic, as it published it; null when none arrived in time."
        }
      }
    },
    "OperatorPresenceAck": {
      "type": "object",
      "required": [
        "accepted",
        "duplicate",
        "stale",
        "state",
        "sequence",
        "action",
        "timeoutSeconds"
      ],
      "properties": {
        "accepted": {
          "type": "boolean"
        },
        "duplicate": {
          "type": "boolean"
        },
        "stale": {
          "type": "boolean"
        },
        "state": {
          "type": "string",
          "enum": [
            "present",
            "lost",
            "left",
            "recovering"
          ]
        },
        "sequence": {
          "type": "integer"
        },
        "action": {
          "type": "string",
          "enum": [
            "slow",
            "pause",
            "notify",
            "stop"
          ]
        },
        "timeoutSeconds": {
          "type": "number"
        }
      }
    },
    "OperatorPresence": {
      "type": "object",
      "required": [
        "state",
        "lastSequence",
        "secondsSinceBeat",
        "action",
        "timeoutSeconds",
        "degradedRobots"
      ],
      "properties": {
        "state": {
          "type": "string",
          "enum": [
            "unknown",
            "present",
            "lost",
            "left",
            "recovering"
          ]
        },
        "lastSequence": {
          "type": [
            "integer",
            "null"
          ]
        },
        "secondsSinceBeat": {
          "type": [
            "integer",
            "null"
          ]
        },
        "action": {
          "type": "string",
          "enum": [
            "slow",
            "pause",
            "notify",
            "stop"
          ]
        },
        "timeoutSeconds": {
          "type": "number"
        },
        "degradedRobots": {
          "type": "array",
          "items": {
            "type": "integer"
          }
        }
      }
    },
    "JwksDocument": {
      "type": "object",
      "required": [
        "keys"
      ],
      "description": "A JSON Web Key Set (RFC 7517) with the public Ed25519 keys that verify the EdDSA sign-in tokens: the active one and, during the overlap of a rotation, the previous one. Public parameters only.",
      "properties": {
        "keys": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "kty",
              "crv",
              "x",
              "kid",
              "use",
              "alg"
            ],
            "properties": {
              "kty": {
                "type": "string",
                "enum": [
                  "OKP"
                ]
              },
              "crv": {
                "type": "string",
                "enum": [
                  "Ed25519"
                ]
              },
              "x": {
                "type": "string",
                "description": "The public key, base64url."
              },
              "kid": {
                "type": "string",
                "description": "The key id (the RFC 7638 thumbprint, shortened); the header of each token names it."
              },
              "use": {
                "type": "string",
                "enum": [
                  "sig"
                ]
              },
              "alg": {
                "type": "string",
                "enum": [
                  "EdDSA"
                ]
              }
            }
          }
        }
      }
    },
    "JwtKeys": {
      "type": "object",
      "required": [
        "algorithm",
        "keys",
        "jwksPath"
      ],
      "description": "The state of the token signing keys. Never any private part.",
      "properties": {
        "algorithm": {
          "type": "string",
          "enum": [
            "HS256",
            "EdDSA"
          ]
        },
        "keys": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "kid",
              "createdAt",
              "retiredAt",
              "active",
              "acceptedUntil"
            ],
            "properties": {
              "kid": {
                "type": "string"
              },
              "createdAt": {
                "type": "integer",
                "description": "Unix seconds."
              },
              "retiredAt": {
                "type": [
                  "integer",
                  "null"
                ],
                "description": "Unix seconds; null for the active key."
              },
              "active": {
                "type": "boolean"
              },
              "acceptedUntil": {
                "type": [
                  "integer",
                  "null"
                ],
                "description": "Unix seconds at which a retired key stops being accepted and published; null for the active key."
              }
            }
          }
        },
        "jwksPath": {
          "type": "string"
        }
      }
    },
    "ServiceIdentityStatus": {
      "type": "object",
      "required": [
        "enabled",
        "source",
        "locked",
        "key",
        "state",
        "services",
        "order"
      ],
      "description": "The identity this server presents to the services it calls: the switch (auth.serviceIdentity.enabled), whether JWT_SECRET can sign, and which services take the identity. Read-only; the switch is changed with PUT /api/admin/server-config.",
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "source": {
          "type": "string",
          "enum": [
            "env",
            "config",
            "default"
          ]
        },
        "locked": {
          "type": "boolean",
          "description": "True when the switch comes from the environment (HYDRA_UMC_SERVICE_IDENTITY) and cannot be changed here."
        },
        "key": {
          "type": "string",
          "enum": [
            "usable",
            "unusable"
          ],
          "description": "Whether JWT_SECRET can sign: unset, an example value or too short is unusable."
        },
        "state": {
          "type": "string",
          "enum": [
            "presenting",
            "idle_no_key",
            "off"
          ]
        },
        "services": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "name",
              "support"
            ],
            "properties": {
              "name": {
                "type": "string",
                "description": "The short name of the service (the repository name without its prefix)."
              },
              "support": {
                "type": "string",
                "enum": [
                  "accepts",
                  "own_verifier",
                  "not_yet"
                ]
              }
            }
          }
        },
        "order": {
          "type": "array",
          "items": {
            "type": "string",
            "enum": [
              "server_first",
              "then_one_by_one",
              "enable_in_root",
              "restart_unit",
              "check_status"
            ]
          },
          "description": "The safe order of the steps, as codes the screens translate."
        }
      }
    },
    "JwtKeyRotated": {
      "type": "object",
      "required": [
        "success",
        "kid",
        "algorithm",
        "keys",
        "jwksPath"
      ],
      "properties": {
        "success": {
          "type": "boolean"
        },
        "kid": {
          "type": "string",
          "description": "The key id of the new active key."
        },
        "algorithm": {
          "type": "string",
          "enum": [
            "HS256",
            "EdDSA"
          ]
        },
        "keys": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "kid",
              "createdAt",
              "retiredAt",
              "active",
              "acceptedUntil"
            ],
            "properties": {
              "kid": {
                "type": "string"
              },
              "createdAt": {
                "type": "integer",
                "description": "Unix seconds."
              },
              "retiredAt": {
                "type": [
                  "integer",
                  "null"
                ],
                "description": "Unix seconds; null for the active key."
              },
              "active": {
                "type": "boolean"
              },
              "acceptedUntil": {
                "type": [
                  "integer",
                  "null"
                ],
                "description": "Unix seconds at which a retired key stops being accepted and published; null for the active key."
              }
            }
          }
        },
        "jwksPath": {
          "type": "string"
        }
      }
    },
    "MaintenanceOutcome": {
      "type": "object",
      "required": [
        "ok",
        "action",
        "exitCode",
        "timedOut",
        "result",
        "message"
      ],
      "description": "What one run of the deploy tool of the operating system image did (status, install, rollback or prune). `result` is the JSON the tool printed on success (the state of the components, or the list of removed releases) and null otherwise; `message` is the last lines the tool printed on its error output, cut to a fixed size.",
      "properties": {
        "ok": {
          "type": "boolean"
        },
        "action": {
          "enum": [
            "status",
            "install",
            "rollback",
            "prune"
          ]
        },
        "exitCode": {
          "type": "integer"
        },
        "timedOut": {
          "type": "boolean"
        },
        "result": {},
        "message": {
          "type": "string"
        }
      }
    }
  }
}
