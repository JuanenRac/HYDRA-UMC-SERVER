                  "snapshots",
                  "recordings"
                ]
              },
              "filename": {
                "type": "string"
              },
              "sizeBytes": {
                "type": "integer"
              },
              "capturedAt": {
                "type": "string"
              },
              "recording": {
                "type": "boolean"
              },
              "durationMs": {
                "type": "integer"
              },
              "frameCount": {
                "type": "integer"
              }
            }
          }
        }
      }
    },
    "CameraProcessStatus": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "required": [
          "status",
          "lastError",
          "port"
        ],
        "properties": {
          "status": {
            "type": "string"
          },
          "lastError": {
            "type": [
              "string",
