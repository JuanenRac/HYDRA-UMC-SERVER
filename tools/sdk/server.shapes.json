          "type": "boolean",
          "description": "Present only when announcing a global stop is configured (safety.publishGlobalStop): whether the retained SAFE_STOP went out on the MQTT bridge."
        },
        "robots": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "robotId",
              "controllerId",
              "name",
              "stopped",
              "valvesOff",
              "pumpsOff"
            ],
            "properties": {
              "robotId": {
                "type": "integer"
              },
              "controllerId": {
                "type": "string"
              },
              "name": {
                "type": "string"
              },
              "stopped": {
                "type": "boolean"
              },
              "valvesOff": {
                "type": "integer"
              },
              "pumpsOff": {
                "type": "integer"
              },
              "reservedBy": {
                "type": "string"
              },
              "error": {
                "type": "string"
              }
            }
          }
        }
      }
    },
    "CameraCapture": {
      "type": "object",
      "required": [
        "success",
        "cameraId",
        "filename"
      ],
      "properties": {
        "success": {
