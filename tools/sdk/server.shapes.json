        },
        "headline": {
          "type": "string"
        },
        "detail": {
          "type": "string"
        },
        "level": {
          "type": "string",
          "enum": [
            "NOMINAL",
            "WARNING",
            "CRITICAL"
          ]
        },
        "speak": {
          "type": "boolean"
        }
      }
    },
    "VoiceReply": {
      "type": "object",
      "required": [
        "type",
        "requestId",
        "text",
        "level",
        "speak",
        "requiresConfirmation"
      ],
      "properties": {
        "type": {
