          "type": "string"
        },
        "level": {
          "type": "string"
        },
        "speak": {
          "type": "boolean"
        },
        "requiresConfirmation": {
          "type": "boolean"
        },
        "visualState": {
          "type": "string"
        },
        "intent": {
          "type": "object"
        },
        "interpretation": {
          "type": "object"
        },
        "messageCode": {
          "type": "string"
        },
        "messageParams": {
          "type": "object"
        },
        "textLanguage": {
          "type": "string"
        },
        "confirmationToken": {
          "type": "string"
        },
        "confirmationValiditySeconds": {
          "type": "number"
        }
      }
    },
    "EcosystemStatus": {
