          "type": "string"
        },
        "stoppedAt": {
          "type": "string"
        }
      }
    },
    "CameraMediaList": {
      "type": "object",
      "required": [
        "items"
      ],
      "properties": {
        "items": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "cameraId",
              "kind",
              "filename",
              "sizeBytes",
              "capturedAt",
              "recording"
            ],
            "properties": {
