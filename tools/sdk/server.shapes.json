      "properties": {
        "success": {
          "type": "boolean"
        },
        "recoveryCodes": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "SystemMetrics": {
      "type": "object",
      "required": [
        "cpu_load",
        "memory_usage",
        "temp",
        "temp_is_real",
        "rp1_temp",
        "uptime",
        "network"
      ],
      "properties": {
        "cpu_load": {
          "type": "number"
        },
        "memory_usage": {
          "type": "number"
        },
        "temp": {
          "type": [
            "number",
            "null"
          ]
        },
        "temp_is_real": {
          "type": "boolean"
        },
        "rp1_temp": {
          "type": [
            "number",
            "null"
          ]
        },
        "uptime": {
          "type": "number"
        },
        "network": {
          "type": "object"
        }
      }
    },
    "HydraInfo": {
      "type": "object",
      "required": [
        "schema_version",
        "product",
        "remoteApiVersion",
        "appVersion",
        "hostname",
        "controllerCount",
        "robotCount",
        "uptimeSeconds"
      ],
      "properties": {
        "schema_version": {
          "type": "string"
        },
        "product": {
          "type": "string"
        },
        "remoteApiVersion": {
          "type": "integer"
        },
        "appVersion": {
          "type": "string"
        },
        "hostname": {
          "type": "string"
        },
        "controllerCount": {
          "type": "integer"
        },
        "robotCount": {
          "type": "integer"
        },
        "uptimeSeconds": {
          "type": "integer"
        },
        "addresses": {
          "type": "array",
          "description": "The addresses of this server on the local network. Present only while an administrator allowed it (discovery.advertiseAddress); a client must not rely on it.",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "Reservation": {
      "type": "object",
      "required": [
        "success",
        "reservationHistory"
      ],
      "properties": {
        "success": {
          "type": "boolean"
        },
        "reservation": {
          "type": [
            "object",
            "null"
          ]
        },
        "reservationHistory": {
          "type": "array",
          "items": {
            "type": "object"
          }
        }
      }
    },
    "StopAllResult": {
      "type": "object",
      "required": [
        "success",
        "stoppedCount",
        "failedCount",
        "persisted",
        "robots"
      ],
      "properties": {
        "success": {
          "type": "boolean"
        },
        "stoppedCount": {
          "type": "integer"
        },
        "failedCount": {
          "type": "integer"
        },
        "persisted": {
          "type": "boolean"
        },
