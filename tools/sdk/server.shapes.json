          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "ServerConfig": {
      "type": "object",
      "required": [
        "port",
        "pendingPort"
      ],
      "properties": {
        "port": {
          "type": "integer"
        },
        "pendingPort": {
          "type": [
            "integer",
            "null"
          ]
        }
      }
    },
    "ServerConfigSaved": {
      "type": "object",
      "required": [
        "success",
        "appliesOnRestart"
      ],
      "properties": {
        "success": {
          "type": "boolean"
        },
        "appliesOnRestart": {
          "type": "boolean"
        }
      }
    },
    "Reachable": {
      "type": "object",
