              },
              "version": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "deploymentTarget": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "servicePort": {
                "type": [
                  "integer",
                  "null"
                ]
              },
              "serviceHealthPath": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "serviceHost": {
