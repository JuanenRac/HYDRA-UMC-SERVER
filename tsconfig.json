{
  "compilerOptions": {
    "target": "es2023",
    "lib": ["ES2023"],
    "types": ["node"],
    "module": "esnext",
    "moduleResolution": "bundler",
    "esModuleInterop": true,
    "skipLibCheck": true,
    // Full strict mode: implicit any, strict function types, strict property
    // initialization and null checks. It also gives the discriminated-union
    // narrowing that users.ts's UserResult needs (`if (!result.ok) result.error`).
    "strict": true,
    "moduleDetection": "force",
    "noEmit": true,

    "noFallthroughCasesInSwitch": true
  },
  "include": ["src"]
}
