{
  "title": "HYDRA-UMC SERVER - Overview",
  "uid": "hydra-umc-overview",
  "id": null,
  "schemaVersion": 39,
  "version": 1,
  "editable": true,
  "graphTooltip": 1,
  "timezone": "browser",
  "time": { "from": "now-6h", "to": "now" },
  "refresh": "10s",
  "tags": ["hydra-umc", "prometheus"],
  "panels": [
    {
      "id": 1,
      "type": "stat",
      "title": "Process Uptime",
      "gridPos": { "h": 4, "w": 4, "x": 0, "y": 0 },
      "datasource": { "type": "prometheus", "uid": "hydraumcprom" },
      "targets": [
        { "expr": "hydra_process_uptime_seconds", "legendFormat": "uptime", "refId": "A" }
      ],
      "fieldConfig": {
        "defaults": { "unit": "s", "color": { "mode": "thresholds" }, "thresholds": { "mode": "absolute", "steps": [{ "color": "green", "value": null }] } },
        "overrides": []
      },
      "options": { "reduceOptions": { "calcs": ["lastNotNull"] }, "textMode": "auto", "graphMode": "none" }
    },
    {
      "id": 2,
      "type": "stat",
      "title": "WebSocket Clients Connected",
      "gridPos": { "h": 4, "w": 4, "x": 4, "y": 0 },
      "datasource": { "type": "prometheus", "uid": "hydraumcprom" },
      "targets": [
        { "expr": "hydra_ws_clients_connected", "legendFormat": "clients", "refId": "A" }
      ],
      "fieldConfig": {
        "defaults": { "unit": "short", "color": { "mode": "thresholds" }, "thresholds": { "mode": "absolute", "steps": [{ "color": "blue", "value": null }] } },
        "overrides": []
      },
      "options": { "reduceOptions": { "calcs": ["lastNotNull"] }, "textMode": "auto", "graphMode": "area" }
    },
    {
      "id": 3,
      "type": "stat",
      "title": "SoC Temperature Is Real",
      "description": "1 = real vcgencmd read (a Pi/CM5 host). 0 = mocked (dev machine without vcgencmd, e.g. Windows/macOS).",
      "gridPos": { "h": 4, "w": 4, "x": 8, "y": 0 },
      "datasource": { "type": "prometheus", "uid": "hydraumcprom" },
      "targets": [
        { "expr": "hydra_system_temp_is_real", "legendFormat": "real", "refId": "A" }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "mappings": [
            { "type": "value", "options": { "0": { "text": "MOCKED", "color": "orange" } } },
            { "type": "value", "options": { "1": { "text": "REAL (vcgencmd)", "color": "green" } } }
          ],
          "color": { "mode": "thresholds" },
          "thresholds": { "mode": "absolute", "steps": [{ "color": "orange", "value": null }, { "color": "green", "value": 1 }] }
        },
        "overrides": []
      },
      "options": { "reduceOptions": { "calcs": ["lastNotNull"] }, "textMode": "value", "graphMode": "none" }
    },
    {
      "id": 4,
      "type": "stat",
      "title": "settings.json Writes (total)",
      "gridPos": { "h": 4, "w": 4, "x": 12, "y": 0 },
      "datasource": { "type": "prometheus", "uid": "hydraumcprom" },
      "targets": [
        { "expr": "hydra_settings_write_duration_seconds_count", "legendFormat": "writes", "refId": "A" }
      ],
      "fieldConfig": {
        "defaults": { "unit": "short", "color": { "mode": "thresholds" }, "thresholds": { "mode": "absolute", "steps": [{ "color": "purple", "value": null }] } },
        "overrides": []
      },
      "options": { "reduceOptions": { "calcs": ["lastNotNull"] }, "textMode": "auto", "graphMode": "none" }
    },
    {
      "id": 5,
      "type": "stat",
      "title": "settings.json Write Latency (p95)",
      "gridPos": { "h": 4, "w": 8, "x": 16, "y": 0 },
      "datasource": { "type": "prometheus", "uid": "hydraumcprom" },
      "targets": [
        {
          "expr": "histogram_quantile(0.95, sum(rate(hydra_settings_write_duration_seconds_bucket[5m])) by (le))",
          "legendFormat": "p95",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "color": { "mode": "thresholds" },
          "thresholds": { "mode": "absolute", "steps": [{ "color": "green", "value": null }, { "color": "yellow", "value": 0.1 }, { "color": "red", "value": 0.5 }] }
        },
        "overrides": []
      },
      "options": { "reduceOptions": { "calcs": ["lastNotNull"] }, "textMode": "auto", "graphMode": "area" }
    },
    {
      "id": 6,
      "type": "timeseries",
      "title": "CPU Load / Memory Usage",
      "description": "hydra_system_cpu_load (os.loadavg()[0] * 10, rounded) and hydra_system_memory_usage_percent - the same figures GET /api/system/metrics reports to the browser UI's own Overview footer.",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 4 },
      "datasource": { "type": "prometheus", "uid": "hydraumcprom" },
      "targets": [
        { "expr": "hydra_system_cpu_load", "legendFormat": "CPU load", "refId": "A" },
        { "expr": "hydra_system_memory_usage_percent", "legendFormat": "Memory usage %", "refId": "B" }
      ],
      "fieldConfig": {
        "defaults": { "unit": "short", "custom": { "drawStyle": "line", "lineWidth": 2, "fillOpacity": 10, "spanNulls": true } },
        "overrides": []
      },
      "options": { "legend": { "displayMode": "list", "placement": "bottom" }, "tooltip": { "mode": "multi" } }
    },
    {
      "id": 7,
      "type": "timeseries",
      "title": "SoC Temperature",
      "description": "hydra_system_temp_celsius - from vcgencmd on a real Pi/CM5 host, mocked (~45-55C) on any other OS. See the \"SoC Temperature Is Real\" panel above.",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 4 },
      "datasource": { "type": "prometheus", "uid": "hydraumcprom" },
      "targets": [
        { "expr": "hydra_system_temp_celsius", "legendFormat": "temp C", "refId": "A" }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "celsius",
          "custom": { "drawStyle": "line", "lineWidth": 2, "fillOpacity": 10, "spanNulls": true },
          "thresholds": { "mode": "absolute", "steps": [{ "color": "green", "value": null }, { "color": "yellow", "value": 70 }, { "color": "red", "value": 80 }] }
        },
        "overrides": []
      },
      "options": { "legend": { "displayMode": "list", "placement": "bottom" }, "tooltip": { "mode": "multi" } }
    },
    {
      "id": 8,
      "type": "timeseries",
      "title": "Atomic Robot Commands, by Type",
      "description": "rate(hydra_robot_commands_total[5m]) by command - jog/play/pause/stop/tool/valve/pump/speed/vision, from POST /api/robot/:id/command.",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 12 },
      "datasource": { "type": "prometheus", "uid": "hydraumcprom" },
      "targets": [
        {
          "expr": "sum by (command) (rate(hydra_robot_commands_total[5m]))",
          "legendFormat": "{{command}}",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": { "unit": "reqps", "custom": { "drawStyle": "bars", "fillOpacity": 40, "stacking": { "mode": "normal" } } },
        "overrides": []
      },
      "options": { "legend": { "displayMode": "list", "placement": "bottom" }, "tooltip": { "mode": "multi" } }
    },
    {
      "id": 9,
      "type": "timeseries",
      "title": "Authentication Failures, by Reason",
      "description": "rate(hydra_auth_failures_total[5m]) by reason - no_token/token_invalid/token_expired (REST), ws_no_token/ws_token_invalid (WebSocket), invalid_credentials (POST /api/login). A sustained non-zero rate here is worth investigating.",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 12 },
      "datasource": { "type": "prometheus", "uid": "hydraumcprom" },
      "targets": [
        {
          "expr": "sum by (reason) (rate(hydra_auth_failures_total[5m]))",
          "legendFormat": "{{reason}}",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "reqps",
          "custom": { "drawStyle": "bars", "fillOpacity": 40, "stacking": { "mode": "normal" } },
          "color": { "mode": "palette-classic" }
        },
        "overrides": []
      },
      "options": { "legend": { "displayMode": "list", "placement": "bottom" }, "tooltip": { "mode": "multi" } }
    },
    {
      "id": 10,
      "type": "timeseries",
      "title": "settings.json Write Latency (p50 / p95 / p99)",
      "description": "Quantiles of hydra_settings_write_duration_seconds - the temp-file write + atomic rename queueSettingsWrite() does for every write (POST /api/settings, POST /api/robot/:id/command, and the WS \"settings\" message all funnel through it).",
      "gridPos": { "h": 8, "w": 24, "x": 0, "y": 20 },
      "datasource": { "type": "prometheus", "uid": "hydraumcprom" },
      "targets": [
        { "expr": "histogram_quantile(0.50, sum(rate(hydra_settings_write_duration_seconds_bucket[5m])) by (le))", "legendFormat": "p50", "refId": "A" },
        { "expr": "histogram_quantile(0.95, sum(rate(hydra_settings_write_duration_seconds_bucket[5m])) by (le))", "legendFormat": "p95", "refId": "B" },
        { "expr": "histogram_quantile(0.99, sum(rate(hydra_settings_write_duration_seconds_bucket[5m])) by (le))", "legendFormat": "p99", "refId": "C" }
      ],
      "fieldConfig": {
        "defaults": { "unit": "s", "custom": { "drawStyle": "line", "lineWidth": 2, "fillOpacity": 5, "spanNulls": true } },
        "overrides": []
      },
      "options": { "legend": { "displayMode": "list", "placement": "bottom" }, "tooltip": { "mode": "multi" } }
    }
  ]
}
