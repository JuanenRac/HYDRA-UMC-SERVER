# Logs
logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

node_modules
dist
dist-ssr
*.local

# HYDRA-UMC STUDIO's built frontend, copied in by build-frontend.sh/.bat -
# a generated artifact from a sibling repo's own build, never source here.
public

# Editor directories and files
.vscode/*
!.vscode/extensions.json
.idea
.DS_Store
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?

data/users.json
data/server-config.json
data/settings.json
data/camera-process-pids.json

# Atomic-write leftovers from queueSettingsWrite's own per-robot points
# files (data/points/<controllerId>/<robotId>.json.<pid>.<timestamp>.tmp) -
# only ever exist if a write was interrupted mid-rename, never meant to be
# committed. Found tracked in git by accident (15 stray files, none newer
# than a real write) while auditing this session's own test-session changes.
*.tmp

# Local secrets (JWT_SECRET, etc.) - see .env.example for the template
.env
.env.local

# HYDRA-UMC shared secret protection
!.env.example

# Python bytecode (generated locally; never source)
__pycache__/
*.py[cod]
