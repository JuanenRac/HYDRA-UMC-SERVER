# Copy this file to .env and fill in real values, or export these same
# variables through your process manager/container of choice instead
# (systemd Environment=, pm2's own env config, Docker -e, ...). Nothing in
# this project auto-loads a .env file today - see README.md's own
# "Environment Variables" section.

# Signs every login token (JWT). Production refuses to start if this is empty.
# Generate a unique high-entropy value; never reuse the development fallback.
JWT_SECRET=

# Marks this as a real deployment rather than a local dev checkout.
# Unset (or anything other than "production") keeps every development
# fallback below active: open CORS, no startup security warnings. Set to
# "production" for any real deployment, especially one reachable beyond a
# fully trusted LAN (e.g. exposed via NAT/port-forward).
NODE_ENV=

# Required only on the FIRST production start, when data/users.json does not
# exist yet. Choose a unique administrator and a strong password. They are
# read only to create the local password hash; never commit them to Git.
HYDRA_UMC_BOOTSTRAP_ADMIN_USERNAME=
HYDRA_UMC_BOOTSTRAP_ADMIN_PASSWORD=

# Comma-separated list of origins allowed to make cross-origin browser
# requests to this API (e.g. where HYDRA-UMC STUDIO is actually served
# from, if it runs on a different host/port than this server). Example:
#   CORS_ALLOWED_ORIGINS=https://studio.example.com,http://192.168.1.20:5173
# If unset: NODE_ENV != production allows any origin (today's default
# behavior, zero setup needed for local dev); NODE_ENV = production
# instead denies every cross-origin browser request until this is set
# (non-browser clients - curl, HYDRA-UMC SUITE, the mobile apps - are
# never affected either way, CORS is a browser-only mechanism).
CORS_ALLOWED_ORIGINS=

# How long a login token stays valid before the client has to log in
# again. Any string jsonwebtoken's own `expiresIn` accepts ("24h", "7d", a
# bare number of seconds, ...). Defaults to 30d if unset (today's
# behavior, fine for a trusted LAN) - a deployment reachable beyond a
# trusted LAN should set something much shorter, e.g. 24h.
JWT_EXPIRES_IN=

# POST /api/login throttling - attempts allowed per IP within the window
# below before further attempts get a 429 response. Defaults to 5 attempts
# / 15 minutes if either is unset.
LOGIN_RATE_LIMIT_MAX=
LOGIN_RATE_LIMIT_WINDOW_MS=

# Only FAILED logins count towards that limit. POST /api/refresh has its own,
# higher budget per IP and window (default 120).
REFRESH_RATE_LIMIT_MAX=

# Require a bearer token on the read-only host information routes
# (/metrics, /api/system/*). Set to "required" for any deployment reachable
# beyond a fully trusted LAN; unset keeps them open. A production start warns
# when unset.
HYDRA_UMC_INFO_AUTH=

# The camera pictures (live streams, saved photos and recordings) demand a
# ticket (POST /api/camera/ticket) or a Bearer token BY DEFAULT. Set to "open"
# only as a temporary opt-out for clients that do not ask for tickets yet.
HYDRA_UMC_CAMERA_AUTH=

# Who may use the relay to the local AI services (/api/ai/*). Unset lets any
# signed-in user; "admin" limits it to administrators.
HYDRA_UMC_AI_ACCESS=

# Log rotation: the live log rotates at HYDRA_UMC_LOG_MAX_BYTES (default 10 MB)
# and HYDRA_UMC_LOG_KEEP rotated files (.1 to .N, default 1) are kept.
HYDRA_UMC_LOG_MAX_BYTES=
HYDRA_UMC_LOG_KEEP=

# The settings (settings.json and the points files) are written as one
# all-or-nothing unit with a journal, with copies of settings.json in
# data/backups/. HYDRA_UMC_SETTINGS_STORE=plain goes back to writing the files
# one by one; HYDRA_UMC_SETTINGS_BACKUPS is the number of copies (default 10,
# 0 = none) and HYDRA_UMC_SETTINGS_BACKUP_INTERVAL_S the least time between two
# copies (default 600).
HYDRA_UMC_SETTINGS_STORE=
HYDRA_UMC_SETTINGS_BACKUPS=
HYDRA_UMC_SETTINGS_BACKUP_INTERVAL_S=

# /ws?token= (a token in the address) is REFUSED by default; clients send the
# "hydra.bearer" WebSocket subprotocol. Set to "allow" only as a temporary
# opt-out for clients that have not moved yet (the token then appears in
# proxy and server logs).
HYDRA_UMC_WS_QUERY_TOKEN=

# Budget of the global stop (POST /api/stop-all) per address, separate from the
# login's. Defaults: 60 calls per 60000 ms.
STOP_ALL_RATE_LIMIT_MAX=
STOP_ALL_RATE_LIMIT_WINDOW_MS=

# Lifetime of a refresh token (a jsonwebtoken-style duration). Unset keeps
# the default of 90 days.
HYDRA_UMC_REFRESH_TOKEN_EXPIRES_IN=

# Optional TLS: set BOTH to switch the server (REST API + the /ws
# WebSocket, which shares the same listener) from plain HTTP/WS to
# HTTPS/WSS. Absolute or relative-to-cwd paths to a PEM certificate and
# its matching private key. Leaving either unset keeps today's plain HTTP
# behavior unchanged. See README.md's own "TLS / HTTPS" section for how to
# get a certificate (Let's Encrypt with a real domain, or self-signed for
# testing).
TLS_CERT_PATH=
TLS_KEY_PATH=
# A NEW installation (no data/server-config.json, settings.json or users.json yet) that already has the certificates of its own authority
# (server.pem and server.key made by hydra_mqtt_tls.sh init in HYDRA_TLS_DIR, default /etc/hydra-umc/tls) starts with TLS on, saved like an
# administrator's choice (the Server Admin screen can switch it off). An existing installation is never changed. off forbids the default
# (the variable wins over the Server Admin option install.newInstallTls).
HYDRA_UMC_NEW_INSTALL_TLS=

# GET /api/ecosystem/health (the health of the services of the ecosystem, for operators and administrators). Only the exact word 1 turns it
# on; it is off by default and then answers 404. The variable wins over the Server Admin option ecosystemHealth.enabled.
HYDRA_UMC_ECOSYSTEM_HEALTH=

# GET /api/node-health (the last health frame the kinematic brain heard from a controller board, read from the SPI bridge; for operators and
# administrators). Only the exact word 1 turns it on; it is off by default and then answers 404. The variable wins over the Server Admin option
# nodeHealth.enabled. The bridge needs --enable-node-health and the brain HYDRA_SPI_HEALTH=1.
HYDRA_UMC_NODE_HEALTH=

# The identity this server presents to the services it calls (health probes, relays, the stop relay, the takeover): a short signed token of
# its own (HS256 with JWT_SECRET, sixty seconds), which a service whose identity key is on asks for. Only the exact word 1 turns it on; it is
# off by default and then nothing is added to any call. A service with a token of its own keeps receiving that one. With a JWT_SECRET that is
# unset, an example value or too short nothing is signed. Turn it on before turning the identity key on in any service.
HYDRA_UMC_SERVICE_IDENTITY=

# POST /api/ai/anomaly-detector/rul (the remaining-useful-life estimate of the anomaly detector, for the card of the AI dashboard). Only the
# exact word 1 opens it to operators; it is off by default and then only an administrator may send it. The variable wins over the
# Server Admin option rul.enabled. The limits (rul.maxBodyBytes, rul.maxPoints, rul.timeoutMs) are read from data/server-config.json.
HYDRA_UMC_RUL=

# Trusted networks: when on, administering the server (users, settings, service control, power, bridges) is refused from addresses outside the
# house (the private ranges, or the ranges listed under trustedNetworks.local) and the VPN (trustedNetworks.vpn), and from outside only accounts
# with the second factor can sign in. Only the exact word 1 turns it on; it is off by default. The variable wins over the Server Admin option
# trustedNetworks.enabled. The ranges, the policy for requests from outside (trustedNetworks.outside: operate or view) and the second-factor rule
# (trustedNetworks.outsideRequiresSecondFactor) are read from data/server-config.json. See docs/REMOTE_ACCESS_VPN.md.
HYDRA_UMC_TRUSTED_NETWORKS=

# Read-only mode of this server: with 1 (or true, on, yes) the server shows its robots and data and changes nothing, for every account and app. A request that writes is
# answered with 423 and the code server-read-only; reading, the sign-in, STOP and the safe-mode disable go on. Off by default; read on every request.
HYDRA_UMC_READ_ONLY=

# POST /api/info/ticket: a signed ticket (?ticket= in the address) opens the read-only information routes (/metrics, the system metrics, the supervisor, the ecosystem
# status) to a scraper or dashboard that cannot send a token, once HYDRA_UMC_INFO_AUTH=required closes them. Only the exact word 1 turns it on; off by default
# (the route then answers 404). The variable wins over the Server Admin option infoTickets.enabled.
HYDRA_UMC_INFO_TICKETS=

# POST /api/admin/device-tokens, GET /api/admin/device-tokens, DELETE /api/admin/device-tokens/{id} and POST /api/device/login: a token issued for one device (the screen
# of a Compute Module) signs it in without a person typing a password. Only the exact word 1 turns it on; off by default (the routes then answer 404). The variable wins
# over the Server Admin option deviceTokens.enabled.
HYDRA_UMC_DEVICE_TOKENS=

# GET /api/admin/updates: the server asks GitHub for the newest release of each program of the ecosystem and sets it against the installed version. Only the exact word 1
# turns it on; off by default (the route then answers 404 and nothing leaves the server). The variable wins over the Server Admin option updateCheck.enabled.
HYDRA_UMC_UPDATE_CHECK=

# GET /api/hydra-info lists the addresses of this server on the local network in `addresses`. Only the exact word 1 turns it on; off by default (no address in the answer).
# The variable wins over the Server Admin option discovery.advertiseAddress.
HYDRA_UMC_ADVERTISE_ADDRESS=

# /api/admin/maintenance: install, go back, prune and list the releases of the programs installed here (it starts the deploy tool of the operating system image,
# without a shell). Only the exact word 1 turns it on; off by default (the routes then answer 404 and nothing is run). The variable wins over the Server Admin option maintenance.enabled.
HYDRA_UMC_MAINTENANCE=

# Sign-in tokens: HS256 with JWT_SECRET (the default), or EdDSA (Ed25519) with the public keys published at GET /.well-known/jwks.json so another service can verify a
# token without a secret. The variable wins over the Server Admin option auth.jwtAlgorithm. The private keys live in HYDRA_UMC_JWT_KEYS_FILE (outside the repository;
# by default ~/.hydra-umc-keys/server-jwt-keys.json). HYDRA_UMC_JWT_ACCEPT_HS256=0 refuses HS256 tokens while EdDSA is in use (default 1, so nobody is signed out at the switch).
HYDRA_UMC_JWT_ALGORITHM=
HYDRA_UMC_JWT_KEYS_FILE=
HYDRA_UMC_JWT_ACCEPT_HS256=

# POST /api/operator/presence: the dead-man of the presence of the operator. A client (the watch, through the phone) sends a numbered heartbeat; when the heartbeats stop, or the
# person says they LEFT, the server acts on the robots that person holds a claim on. Only the exact word 1 turns it on; off by default (the route then answers 404). The variable
# wins over the Server Admin option presence.enabled. The times (timeoutSeconds, slowFactor, recoverBeats, rampSeconds, leftImmediate) are in data/server-config.json, block "presence".
HYDRA_UMC_PRESENCE=
# What a lost heartbeat does once the function is on: slow (default: lowers the speed of the robots of that operator and warns), pause, notify (only warns) or stop. A word that is
# not one of the four is ignored. The variable wins over the Server Admin option presence.action.
HYDRA_UMC_PRESENCE_ACTION=

# The MQTT bridge also publishes the discovery configs of each robot for Home Assistant (retained, under homeassistant/). Only the exact word 1 turns it on; off by
# default, applies on the next start. The variable wins over the Server Admin option mqtt.homeAssistant.enabled.
HYDRA_UMC_MQTT_HOME_ASSISTANT=

# Directory holding real, checked-out HYDRA-UMC-*/URTC-* sibling repos to
# scan for GET /api/ecosystem/status (STUDIO's Ecosystem > Services panel).
# Unset defaults to this repo's own parent directory - correct for a local
# dev checkout where every repo sits flat next to this one, WRONG for a real
# CM5 deployment (whose own working directory's parent holds only build
# artifacts, not full checkouts with a hydra-umc.project.json manifest). Set
# this to wherever the real manifests actually live on a real deployment
# (e.g. the staging tree the build/deploy scripts check every repo out
# into) so the panel reflects real services instead of always reporting
# zero.
HYDRA_UMC_ECOSYSTEM_ROOT=

# Optional local HYDRA-UMC-VOICE-UI relay. Keep this URL on loopback in a CM5
# deployment. The token must exactly match Voice UI's local environment file;
# it is never sent to Android, Watch or browser clients.
HYDRA_UMC_VOICE_UI_URL=
HYDRA_UMC_VOICE_UI_TOKEN=
HYDRA_UMC_VOICE_UI_TIMEOUT_MS=4000

# Optional local spi_bridge relay (HYDRA-UMC repo's src/cm5_host/spi_bridge/
# service) - the real CM5<->STM32H757 SPI-OTA link STUDIO's Flasher/Tester
# use once `settings.canOta.transport === 'hardware'`. Keep this on loopback
# in a CM5 deployment; leaving it unset keeps every /api/hardware/canota/*
# route answering 503 instead of pretending hardware is connected.
HYDRA_UMC_SPI_BRIDGE_URL=
HYDRA_UMC_SPI_BRIDGE_TIMEOUT_MS=4000
HYDRA_UMC_SPI_BRIDGE_FLASH_TIMEOUT_MS=120000

# Optional local relays. Keep both on loopback in a CM5 deployment.
HYDRA_UMC_DATALAKE_URL=
HYDRA_UMC_CONNECTOR_HUB_URL=
# The decision gate of the hub (serve-gate): the relay carries the token of the signed-in person. Empty: off.
HYDRA_UMC_CONNECTOR_HUB_GATE_URL=
# The semantic planner (its HTTP API, e.g. http://127.0.0.1:PORT): STUDIO shows and edits through it whether the approval of a plan needs the person who is signed in.
# Off (the relay answers 503) until it is set; the planner keeps the switch (plan_approval.require_identity, true by default) and the last word.
HYDRA_UMC_SEMANTIC_PLANNER_URL=
# The HIL bridge (its HTTP API, e.g. http://127.0.0.1:PORT): STUDIO and SUITE show and edit through it whether a real command needs a pass verdict of the twin.
# Off (the relay answers 503) until it is set; the bridge keeps the switch (require_twin_pass, off by default) and the last word.
HYDRA_UMC_HIL_BRIDGE_URL=
# The safety zones service (its HTTP API, e.g. http://127.0.0.1:PORT, started with --tool-arms): the panels read through this server the arm state of the URTC tools.
# Off (the read answers 503) until it is set; the service only records what the driving service reports and never arms, disarms or stops anything.
HYDRA_UMC_SAFETY_ZONES_URL=
# The push route of the twin (its own WebSocket, e.g. ws://127.0.0.1:8112/twin/ws): the panels watch it through /api/twin/ws with the token of the person who is signed in.
# Off (the route answers that the twin is not configured) until it is set; the twin keeps its own limits and the last word.
HYDRA_UMC_TWIN_WS_URL=
# The URTC tool changer service (its HTTP API, e.g. http://127.0.0.1:PORT): the reset of the arm state of a tool changer (POST /api/tool-arms/reset) is forwarded to its POST /atc/reset.
# Off (the route answers 503) until it is set; the route itself stays off (404) until the Server Admin option atc.resetEnabled, or the variable below, is on.
HYDRA_UMC_ATC_URL=
# Only the exact word 1 turns the reset of the arm state of a tool changer on; off by default. The variable wins over the Server Admin option atc.resetEnabled.
HYDRA_UMC_ATC_RESET=
# The node watchdog (OPS-AGENT) over its authenticated channel: STUDIO and SUITE list the proposals that wait for a person and approve or reject them.
# Off (the routes answer 503) until both are set. The registry file holds {"nodes": {"hydra-umc-server": "<secret>", "edge": "<secret>"}} (secrets of 16+ characters, never in a repository).
HYDRA_UMC_OPS_AGENT_URL=
HYDRA_UMC_OPS_AGENT_REGISTRY_FILE=

# Audit record of claims, forced releases, safety limits, jog arming and global stops (data/audit.jsonl).
# On by default; "off" locks it off (an administrator cannot switch it on from the control app).
# HYDRA_UMC_AUDIT_MAX_BYTES is the size at which the file is rotated (default 5242880), HYDRA_UMC_AUDIT_KEEP the rotated files kept (default 5).
HYDRA_UMC_AUDIT=
HYDRA_UMC_AUDIT_MAX_BYTES=
HYDRA_UMC_AUDIT_KEEP=

# Camera addresses with a password are handed to the camera process through its environment; "off" puts them back in its arguments
# (only for a streamer that does not know --device-env). The variable wins over the Server Admin option camera.credentialsViaEnv.
HYDRA_UMC_CAMERA_CREDENTIALS_VIA_ENV=

# Secret redaction of every log line; "off" is for debugging on a bench only.
HYDRA_UMC_LOG_REDACTION=

# Registry of the services of the ecosystem (contracts/ports.yaml of the SDK). The ecosystem status uses it for the port,
# health path and unit a project's manifest does not declare. Unset: looked for in the SDK checkout next to the other repositories.
# "off" turns it off; a path names the file to read.
HYDRA_UMC_PORTS_REGISTRY=

# Request limits per address: off switches every limiter off (default: on). The numbers above (LOGIN_/REFRESH_/API_/SENSITIVE_/STOP_ALL_RATE_LIMIT_*) can also be set in Server Admin.
HYDRA_UMC_RATE_LIMITS=

# What the sibling services hand to the server (each is off unless set to 1): scenario outcomes, the status of the developer node, the faults
# Every switch below can also be turned on in Server Admin (the ingest block of the server settings); a variable set here (1 or 0) decides and locks it there.
HYDRA_UMC_INGEST_SCENARIO=
HYDRA_UMC_INGEST_DEVELOPER_NODE=
HYDRA_UMC_DEVELOPER_NODE_TOKENS_FILE=
HYDRA_UMC_FAULT_FEED=
HYDRA_UMC_FAULT_FEED_TOPIC=

# The verdicts of the anomaly detector read from the broker (read only; off unless set to 1), and whether a change to suspect or anomalous is told to the voice interface
HYDRA_UMC_ANOMALY_FEED=
HYDRA_UMC_ANOMALY_FEED_TOPIC=
HYDRA_UMC_ANOMALY_VOICE_RELAY=
HYDRA_UMC_ANOMALY_VOICE_LOCALE=

# The record of the voice commands that pass through the server, signed with its key and chained by hash (off unless set to 1)
HYDRA_UMC_VOICE_CHAIN=

# The check of a trajectory proposal signed with Ed25519 (off unless set to 1) and the file of the public keys of the operators
HYDRA_UMC_PROPOSAL_VERIFY=
HYDRA_UMC_PROPOSAL_KEYS_FILE=

# POST /api/operator/confirmations: issues the one-use token of the confirmation of a person that the machine bridges (UAV, droids) ask for before a flight or walking request.
# Only a plain yes (1, true, on, yes) turns it on; off by default (the route then answers 404). It needs a key: a file of at least 32 characters, outside the repository
# (by default ~/.hydra-umc-keys/human-confirmation.key); without one the route answers 503 and issues nothing. The same key goes to the bridges (confirmation.key_file / policy.confirmation_key_file).
HYDRA_UMC_HUMAN_CONFIRMATION=
HYDRA_UMC_HUMAN_CONFIRMATION_KEY_FILE=
