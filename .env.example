# Copy this file to .env and fill in real values, or export these same
# variables through your process manager/container of choice instead
# (systemd Environment=, pm2's own env config, Docker -e, ...). Nothing in
# this project auto-loads a .env file today - see README.md's own
# "Environment Variables" section.

# Signs every login token (JWT). Production refuses to start if this is empty.
# Generate a unique high-entropy value; never reuse the development fallback.
JWT_SECRET=

# Marks this as a real deployment rather than a local dev checkout.
# Unset (or anything other than "production") keeps every development
# fallback below active: open CORS, no startup security warnings. Set to
# "production" for any real deployment, especially one reachable beyond a
# fully trusted LAN (e.g. exposed via NAT/port-forward).
NODE_ENV=

# Required only on the FIRST production start, when data/users.json does not
# exist yet. Choose a unique administrator and a strong password. They are
# read only to create the local password hash; never commit them to Git.
HYDRA_UMC_BOOTSTRAP_ADMIN_USERNAME=
HYDRA_UMC_BOOTSTRAP_ADMIN_PASSWORD=

# Comma-separated list of origins allowed to make cross-origin browser
# requests to this API (e.g. where HYDRA-UMC STUDIO is actually served
# from, if it runs on a different host/port than this server). Example:
#   CORS_ALLOWED_ORIGINS=https://studio.example.com,http://192.168.1.20:5173
# If unset: NODE_ENV != production allows any origin (today's default
# behavior, zero setup needed for local dev); NODE_ENV = production
# instead denies every cross-origin browser request until this is set
# (non-browser clients - curl, HYDRA-UMC SUITE, the mobile apps - are
# never affected either way, CORS is a browser-only mechanism).
CORS_ALLOWED_ORIGINS=

# How long a login token stays valid before the client has to log in
# again. Any string jsonwebtoken's own `expiresIn` accepts ("24h", "7d", a
# bare number of seconds, ...). Defaults to 30d if unset (today's
# behavior, fine for a trusted LAN) - a deployment reachable beyond a
# trusted LAN should set something much shorter, e.g. 24h.
JWT_EXPIRES_IN=

# POST /api/login throttling - attempts allowed per IP within the window
# below before further attempts get a 429 response. Defaults to 5 attempts
# / 15 minutes if either is unset.
LOGIN_RATE_LIMIT_MAX=
LOGIN_RATE_LIMIT_WINDOW_MS=

# Optional TLS: set BOTH to switch the server (REST API + the /ws
# WebSocket, which shares the same listener) from plain HTTP/WS to
# HTTPS/WSS. Absolute or relative-to-cwd paths to a PEM certificate and
# its matching private key. Leaving either unset keeps today's plain HTTP
# behavior unchanged. See README.md's own "TLS / HTTPS" section for how to
# get a certificate (Let's Encrypt with a real domain, or self-signed for
# testing).
TLS_CERT_PATH=
TLS_KEY_PATH=

# Directory holding real, checked-out HYDRA-UMC-*/URTC-* sibling repos to
# scan for GET /api/ecosystem/status (STUDIO's Ecosystem > Services panel).
# Unset defaults to this repo's own parent directory - correct for a local
# dev checkout where every repo sits flat next to this one, WRONG for a real
# CM5 deployment (whose own working directory's parent holds only build
# artifacts, not full checkouts with a hydra-umc.project.json manifest). Set
# this to wherever the real manifests actually live on a real deployment
# (e.g. the staging tree the build/deploy scripts check every repo out
# into) so the panel reflects real services instead of always reporting
# zero.
HYDRA_UMC_ECOSYSTEM_ROOT=

# Optional local HYDRA-UMC-VOICE-UI relay. Keep this URL on loopback in a CM5
# deployment. The token must exactly match Voice UI's local environment file;
# it is never sent to Android, Watch or browser clients.
HYDRA_UMC_VOICE_UI_URL=
HYDRA_UMC_VOICE_UI_TOKEN=
HYDRA_UMC_VOICE_UI_TIMEOUT_MS=4000

# Optional local spi_bridge relay (HYDRA-UMC repo's src/cm5_host/spi_bridge/
# service) - the real CM5<->STM32H745 SPI-OTA link STUDIO's Flasher/Tester
# use once `settings.canOta.transport === 'hardware'`. Keep this on loopback
# in a CM5 deployment; leaving it unset keeps every /api/hardware/canota/*
# route answering 503 instead of pretending hardware is connected.
HYDRA_UMC_SPI_BRIDGE_URL=
HYDRA_UMC_SPI_BRIDGE_TIMEOUT_MS=4000
HYDRA_UMC_SPI_BRIDGE_FLASH_TIMEOUT_MS=120000
